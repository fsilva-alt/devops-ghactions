{
  "name": "Curso de GitHub Actions",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "CURSO_AUTH_GITHUB=0 sh install.sh",
  "customizations": {
    "vscode": {
      "extensions": ["github.vscode-github-actions", "ms-python.python"]
    }
  }
}
