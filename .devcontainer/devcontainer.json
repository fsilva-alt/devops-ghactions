{
  "name": "Desenvolvimento do curso de GitHub Actions",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -r scripts/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["github.vscode-github-actions", "ms-python.python"]
    }
  }
}
